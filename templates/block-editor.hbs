<div class="veiled-rolls-root veiled-rolls-editor-root">
  {{#if errors.length}}
  <div class="veiled-rolls-errors" role="alert">
    <p><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.HasErrors"}}</p>
    <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  <nav class="veiled-rolls-tabs" role="tablist">
    {{#each tabs}}
    <button type="button" role="tab" class="veiled-rolls-tab {{#if (veiledEq this.id ../tab)}}is-active{{/if}}"
            data-tab-id="{{this.id}}" aria-selected="{{#if (veiledEq this.id ../tab)}}true{{else}}false{{/if}}">
      {{localize this.label}}
    </button>
    {{/each}}
  </nav>

  <div class="veiled-rolls-tab-body">
    {{!-- GENERAL --}}
    {{#if (veiledEq tab "general")}}
    <section class="veiled-rolls-form-grid">
      <label>{{localize "VEILED_ROLLS.Editor.Name"}}
        <input type="text" name="name" value="{{block.name}}" required />
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.Folder"}}
        <input type="text" name="folder" value="{{block.folder}}" />
      </label>
      <label class="veiled-rolls-full">{{localize "VEILED_ROLLS.Editor.Description"}}
        <textarea name="description" rows="3">{{block.description}}</textarea>
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.Mode"}}
        <select name="mode">
          {{#each modes}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </label>
    </section>
    {{/if}}

    {{!-- ROLLS --}}
    {{#if (veiledEq tab "rolls")}}
    <section>
      <p class="veiled-rolls-hint">{{localize "VEILED_ROLLS.Editor.RollsHint"}}</p>
      {{#each selectors}}
      <fieldset class="veiled-rolls-row-fields">
        <label>{{localize "VEILED_ROLLS.Editor.RollType"}}
          <select name="sel-{{@index}}-roll_type" data-vr-refresh>
            {{#each this.rollTypes}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "VEILED_ROLLS.Editor.Key"}}
          <select name="sel-{{@index}}-key">
            <option value="">—</option>
            {{#each this.keyChoices}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "VEILED_ROLLS.Editor.SelectorLabel"}}
          <input type="text" name="sel-{{@index}}-label" value="{{this.label}}" />
        </label>
        <label>{{localize "VEILED_ROLLS.Editor.Branch"}}
          <select name="sel-{{@index}}-branch_id">
            <option value="">—</option>
            {{#each this.branches}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </label>
        <button type="button" class="veiled-rolls-icon veiled-rolls-danger" data-action="removeSelector" data-index="{{@index}}"
                aria-label="{{localize "VEILED_ROLLS.Editor.RemoveSelector"}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      </fieldset>
      {{/each}}
      <button type="button" data-action="addSelector"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.AddSelector"}}</button>
    </section>
    {{/if}}

    {{!-- RESPONSES --}}
    {{#if (veiledEq tab "responses")}}
    <section>
      <p class="veiled-rolls-hint">{{localize "VEILED_ROLLS.Editor.ResponsesHint"}}</p>
      {{#each branches}}
      <fieldset class="veiled-rolls-branch">
        <legend>{{localize "VEILED_ROLLS.Editor.BranchLegend"}} — {{this.displayName}}</legend>
        <div class="veiled-rolls-row-fields">
          <label>{{localize "VEILED_ROLLS.Editor.BranchLabel"}}
            <input type="text" name="br-{{@index}}-label" value="{{this.label}}"
                   placeholder="{{localize "VEILED_ROLLS.Editor.BranchLabelHint"}}" />
          </label>
          <label>{{localize "VEILED_ROLLS.Editor.RollType"}}
            <select name="br-{{@index}}-roll_type" data-vr-refresh>
              {{#each this.rollTypes}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>{{localize "VEILED_ROLLS.Editor.Key"}}
            <select name="br-{{@index}}-key">
              <option value="">—</option>
              {{#each this.keyChoices}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          <button type="button" class="veiled-rolls-icon veiled-rolls-danger" data-action="removeBranch" data-index="{{@index}}"
                  aria-label="{{localize "VEILED_ROLLS.Editor.RemoveBranch"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
        </div>

        {{#each this.tiers}}
        <div class="veiled-rolls-tier">
          <div class="veiled-rolls-row-fields">
            <label>{{localize "VEILED_ROLLS.Editor.Min"}}
              <input type="number" name="tier-{{@../index}}-{{@index}}-min" value="{{this.minimum}}" />
            </label>
            <label>{{localize "VEILED_ROLLS.Editor.Max"}}
              <input type="number" name="tier-{{@../index}}-{{@index}}-max" value="{{this.maximum}}" />
            </label>
            <label>{{localize "VEILED_ROLLS.Editor.Natural"}}
              <select name="tier-{{@../index}}-{{@index}}-natural">
                {{#each ../../naturalOptions}}
                <option value="{{this}}" {{#if (veiledEq this ../natural_roll)}}selected{{/if}}>{{localize (concat "VEILED_ROLLS.Natural." this)}}</option>
                {{/each}}
              </select>
            </label>
            <button type="button" class="veiled-rolls-icon veiled-rolls-danger" data-action="removeTier"
                    data-branch="{{@../index}}" data-tier="{{@index}}"
                    aria-label="{{localize "VEILED_ROLLS.Editor.RemoveTier"}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
          </div>
          <label class="veiled-rolls-full">{{localize "VEILED_ROLLS.Editor.Responses"}}
            <textarea name="tier-{{@../index}}-{{@index}}-responses" rows="2"
                      placeholder="{{localize "VEILED_ROLLS.Editor.ResponsesPlaceholder"}}">{{this.responsesText}}</textarea>
          </label>
          <label class="veiled-rolls-full">{{localize "VEILED_ROLLS.Editor.GmNote"}}
            <input type="text" name="tier-{{@../index}}-{{@index}}-gm_note" value="{{this.gm_note}}" />
          </label>
        </div>
        {{/each}}
        <button type="button" data-action="addTier" data-index="{{@index}}">
          <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.AddTier"}}
        </button>
      </fieldset>
      {{/each}}
      <button type="button" data-action="addBranch"><i class="fa-solid fa-code-branch" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.AddBranch"}}</button>
    </section>
    {{/if}}

    {{!-- PARTICIPANTS --}}
    {{#if (veiledEq tab "participants")}}
    <section class="veiled-rolls-form-grid">
      <label>{{localize "VEILED_ROLLS.Editor.ParticipantMode"}}
        <select name="participant_mode">
          {{#each participantModes}}
          <option value="{{this}}" {{#if (veiledEq this ../block.options.participant_mode)}}selected{{/if}}>{{localize (concat "VEILED_ROLLS.Mode." this)}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.DuplicatePolicy"}}
        <select name="duplicate_policy">
          {{#each duplicatePolicies}}
          <option value="{{this}}" {{#if (veiledEq this ../block.options.duplicate_policy)}}selected{{/if}}>{{localize (concat "VEILED_ROLLS.Duplicate." this)}}</option>
          {{/each}}
        </select>
      </label>
      <label class="veiled-rolls-full">{{localize "VEILED_ROLLS.Editor.ParticipantIds"}}
        <textarea name="participant_ids" rows="3" placeholder="{{localize "VEILED_ROLLS.Editor.ParticipantIdsHint"}}">{{participantIds}}</textarea>
      </label>
    </section>
    {{/if}}

    {{!-- OPTIONS --}}
    {{#if (veiledEq tab "options")}}
    <section class="veiled-rolls-form-grid">
      <label class="veiled-rolls-check"><input type="checkbox" name="include_gm_in_whisper" {{#if block.options.include_gm_in_whisper}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.IncludeGm"}}</label>
      <label class="veiled-rolls-check"><input type="checkbox" name="show_total_to_gm" {{#if block.options.show_total_to_gm}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.ShowTotal"}}</label>
      <label class="veiled-rolls-check"><input type="checkbox" name="show_result_to_player" {{#if block.options.show_result_to_player}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.ShowResultPlayer"}}</label>
      <label class="veiled-rolls-check"><input type="checkbox" name="color_by_tier" {{#if block.options.color_by_tier}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.ColorByTier"}}</label>
      <label>{{localize "VEILED_ROLLS.Editor.DiceSoNice"}}
        <select name="dice_so_nice_mode">
          {{#each diceModes}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="veiled-rolls-check"><input type="checkbox" name="randomize_equal_tier_responses" {{#if block.options.randomize_equal_tier_responses}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.Randomize"}}</label>
      <label class="veiled-rolls-check"><input type="checkbox" name="send_fallback_response" {{#if block.options.send_fallback_response}}checked{{/if}} /> {{localize "VEILED_ROLLS.Editor.SendFallback"}}</label>
      <label class="veiled-rolls-full">{{localize "VEILED_ROLLS.Editor.Fallback"}}
        <textarea name="fallback_response" rows="2">{{block.options.fallback_response}}</textarea>
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.AutoClose"}}
        <select name="auto_close_mode">
          {{#each autoCloseModes}}
          <option value="{{this}}" {{#if (veiledEq this ../block.options.auto_close_mode)}}selected{{/if}}>{{localize (concat "VEILED_ROLLS.AutoClose." this)}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.AutoCloseCount"}}
        <input type="number" name="auto_close_roll_count" min="1" value="{{block.options.auto_close_roll_count}}" />
      </label>
    </section>
    {{/if}}
  </div>

  <section class="veiled-rolls-test">
    <h3>{{localize "VEILED_ROLLS.Editor.TestTitle"}}</h3>
    <div class="veiled-rolls-row-fields">
      <label>{{localize "VEILED_ROLLS.Editor.TestSelector"}}
        <select name="test_selector">
          {{#each testChoices}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VEILED_ROLLS.Editor.TestTotal"}}
        <input type="number" name="test_total" value="{{testTotal}}" />
      </label>
      <button type="button" data-action="test"><i class="fa-solid fa-flask" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.Test"}}</button>
    </div>
    {{#if testResult}}
    <div class="veiled-rolls-test-result">
      {{#each testResult}}<p>{{this}}</p>{{/each}}
    </div>
    {{/if}}
  </section>

  <footer class="veiled-rolls-editor-footer">
    <button type="button" data-action="cancel">{{localize "VEILED_ROLLS.Editor.Cancel"}}</button>
    <button type="button" data-action="saveActivate"><i class="fa-solid fa-bolt" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.SaveActivate"}}</button>
    <button type="button" class="veiled-rolls-primary" data-action="save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "VEILED_ROLLS.Editor.Save"}}</button>
  </footer>
</div>
